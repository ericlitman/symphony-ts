{
  "name": "symphony-ts",
  "version": "2026.03.23.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "TypeScript implementation of Symphony",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "symphony": "./dist/src/cli/main.js",
    "symphony-backlog-audit": "./dist/src/audit/backlog-audit-cli.js",
    "symphony-calibration-digest": "./dist/src/calibration/cli.js",
    "claude-runner": "./dist/src/cli/claude-runner.js",
    "symphony-capability-retest": "./dist/src/cli/capability-retest.js",
    "symphony-manager-plan": "./dist/src/cli/manager-plan.js",
    "symphony-advisory-grade": "./dist/src/cli/advisory-grade.js",
    "symphony-linear-portfolio": "./dist/src/cli/linear-portfolio-write.js",
    "symphony-investigate-productivity-report": "./dist/src/cli/investigate-productivity-report.js",
    "symphony-spec-review-watch": "./dist/src/cli/spec-review-watch.js",
    "symphonyctl": "./dist/src/cli/symphonyctl.js"
  },
  "files": ["dist/src", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OasAIStudio/symphony-ts.git"
  },
  "bugs": {
    "url": "https://github.com/OasAIStudio/symphony-ts/issues"
  },
  "homepage": "https://github.com/OasAIStudio/symphony-ts#readme",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run validate:skill-installs",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "smoke:review": "vitest run tests/review/crucible-contract-smoke.test.ts tests/review/crucible-spine-conformance.test.ts tests/review/crucible-consumer-replay.test.ts",
    "validate:skill-installs": "node scripts/validate-skill-installs.mjs",
    "probe:codex-skills": "node scripts/probe-codex-skills.mjs",
    "smoke:codex-headless": "node scripts/probe-codex-skills.mjs --ci-smoke",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:check": "node scripts/docs-sync.mjs --check",
    "architecture:test": "node --test scripts/architecture/index.js",
    "architecture:check": "node scripts/architecture/check-file-size-ratchet.mjs && node scripts/architecture/check-god-files.mjs && node scripts/architecture/check-env-registry.mjs && node scripts/architecture/check-dead-exports.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^29.0.1",
    "knip": "^6.25.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/provider": "^3.0.8",
    "@google/gemini-cli-core": "^0.33.2",
    "@google/genai": "^1.45.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.15.0",
    "ai": "^6.0.116",
    "ai-sdk-provider-claude-code": "^3.4.4",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "graphql": "^16.13.1",
    "liquidjs": "^10.27.2",
    "undici": "^7.30.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
